# PREMORTEM v2 · variables de entorno. Copia a .env.local (ignorado por Git) y rellena.
# Ningún valor real debe vivir en este archivo ni pegarse en chats o tickets.

# --- Supabase: proyecto fyybyttemawstuuxcmjh -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://fyybyttemawstuuxcmjh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # Dashboard → Settings → API (clave publicable, apta para el navegador)

# Conexiones directas (solo servidor). Host del pooler: Dashboard → Connect.
SUPABASE_DB_ADMIN_URL=                       # session pooler · usuario postgres.<ref> · 5432 · solo migraciones y scripts
SUPABASE_DB_URL_API=                         # transaction pooler · usuario premortem_api.<ref> · 6543 · API (prepare: false)
SUPABASE_DB_URL_WORKER=                      # session pooler · usuario premortem_worker.<ref> · 5432 · worker persistente
PREMORTEM_API_PASSWORD=                      # openssl rand -base64 32 · se aplica con scripts/db-set-role-passwords.sh
PREMORTEM_WORKER_PASSWORD=                   # openssl rand -base64 32 · idem
SUPABASE_SERVICE_ROLE_KEY=                   # opcional: solo para el seed que crea el usuario demo vía Auth Admin

# --- Cifrado de sobre (AES-256-GCM en la aplicación) -----------------------------------
PREMORTEM_KEK=                               # openssl rand -base64 32 · clave maestra que envuelve las DEK
PREMORTEM_KEK_ID=kek-2026-10                 # identificador guardado junto a cada DEK envuelta
PREMORTEM_PROMPT_HMAC_KEY=                   # openssl rand -base64 32 · igualdad de prompts sin descifrar (ámbito por tenant)

# --- Stripe (sandbox) ------------------------------------------------------------------
STRIPE_SECRET_KEY=                           # clave de prueba (sk_test_…); nunca una clave live en este proyecto
STRIPE_WEBHOOK_SECRET=                       # emitido por `stripe listen` en local o por el endpoint en el Dashboard
STRIPE_PRICE_ID_UNITS_20=                    # Price de prueba: 20 unidades por US$5 (lo crea pnpm stripe:setup:test)
APP_ORIGIN=http://localhost:3000             # origen fijo para success_url / cancel_url

# --- Modelo (driver anthropic, opcional) -----------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=                          # opcional: endpoint compatible (p. ej. AI Gateway) para usar créditos del evento

# --- Motor -----------------------------------------------------------------------------
PREMORTEM_ENGINE_VERSION=0.1.0
PREMORTEM_LEASE_SECONDS=60
PREMORTEM_HEARTBEAT_SECONDS=15
PREMORTEM_WORKER_CONCURRENCY=4
PREMORTEM_API_URL=http://localhost:3000
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Local (supabase start en este repo usa los puertos 56xxx) --------------------------
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
